{
  "schema": "desarrollamo.amo.v1",
  "amo_version": "1.0.0",
  "id": "storeamo-install",
  "name": "StoreAMO-Install",
  "kind": "product",
  "origin": "legacy",
  "membership": "candidate",
  "trust": "inspected",
  "unit": {
    "purpose": "Ser la puerta de entrada multiplataforma a StoreAMO sin contener claves privadas ni saltarse las protecciones del sistema operativo.",
    "responsibility": "Resolver la plataforma y derivar a la entrada oficial de StoreAMO, verificando en Android la release bootstrap y su SHA-256 antes de abrir el instalador visible del sistema.",
    "owner": "human_responsible",
    "capabilities": ["distribution-entrypoint", "bootstrap-discovery", "sha256-verification", "platform-routing"]
  },
  "model": {
    "inherits": [],
    "context": ["README.md", "install.sh", "install.fish", "install.ps1"],
    "rules": [
      "No contiene claves privadas ni material de firma.",
      "No instala APK de forma silenciosa ni evita la confirmación visible de Android.",
      "La entrada Android debe permanecer fijada a una release bootstrap explícita y verificar SHA-256."
    ]
  },
  "map": {
    "parent": "raizamo",
    "children": [],
    "relations": [
      {"type": "distribution-entrypoint-for", "target": "storeamo", "strength": "strong"}
    ],
    "covers": ["install.sh", "install.fish", "install.ps1", "install.cmd", "ios/**"]
  },
  "policy": {
    "contains_private_signing_material": false,
    "silent_install_allowed": false,
    "system_confirmation_required": true
  },
  "provenance": {
    "source_uri": "https://github.com/amoedo7/StoreAMO-Install",
    "source_type": "git-repository",
    "source_ref": "769b338e39a0a1b665cb1c768a65b72ae049601d"
  },
  "health": {
    "checks": [
      {
        "id": "storeamo-install-autocheck",
        "type": "command",
        "command": "bash scripts/autocheck.sh",
        "cwd": ".",
        "timeout_seconds": 60,
        "description": "Valida sintaxis, pin explícito de Bootstrap 0.0.3, assets oficiales y ausencia de la release bootstrap insegura 0.0.2."
      }
    ]
  },
  "evidence": {
    "status": "inspected",
    "refs": [".github/workflows/install-ci.yml", "scripts/autocheck.sh"]
  }
}
