{
  "schema": "desarrollamo.amo.v1",
  "amo_version": "1.0.0",
  "id": "storeamo-install",
  "name": "StoreAMO-Install",
  "kind": "product",
  "origin": "legacy",
  "membership": "candidate",
  "trust": "inspected",
  "unit": {
    "purpose": "Ser la puerta de entrada multiplataforma a StoreAMO sin contener claves privadas ni saltarse las protecciones del sistema operativo.",
    "responsibility": "Resolver la plataforma y derivar a StoreAMO Install; en Android fijar la release del helper, verificar SHA-256 y usar una frontera de instalación dedicada con confirmación visible del sistema.",
    "owner": "human_responsible",
    "capabilities": ["distribution-entrypoint", "bootstrap-discovery", "sha256-verification", "platform-routing", "package-installer-boundary"]
  },
  "model": {
    "inherits": [],
    "context": ["README.md", "install.sh", "install.fish", "install.ps1"],
    "rules": [
      "No contiene claves privadas ni material de firma.",
      "No instala APK de forma silenciosa ni evita la confirmación visible de Android.",
      "La entrada Android permanece fijada a una release StoreAMO Install explícita y verifica SHA-256.",
      "REQUEST_INSTALL_PACKAGES pertenece sólo al helper dedicado; StoreAMO principal no lo hereda.",
      "No desactivar ni eludir Play Protect o políticas del dispositivo."
    ]
  },
  "map": {
    "parent": "raizamo",
    "children": [],
    "relations": [
      {"type": "distribution-entrypoint-for", "target": "storeamo", "strength": "strong"}
    ],
    "covers": ["install.sh", "install.fish", "install.ps1", "install.cmd", "ios/**"]
  },
  "policy": {
    "contains_private_signing_material": false,
    "silent_install_allowed": false,
    "system_confirmation_required": true,
    "play_protect_bypass_allowed": false
  },
  "provenance": {
    "source_uri": "https://github.com/amoedo7/StoreAMO-Install",
    "source_type": "git-repository",
    "source_ref": "main"
  },
  "health": {
    "checks": [
      {
        "id": "storeamo-install-autocheck",
        "type": "command",
        "command": "bash scripts/autocheck.sh",
        "cwd": ".",
        "timeout_seconds": 60,
        "description": "Valida sintaxis, pin explícito de StoreAMO Install 0.0.5, rutas oficiales, verificación SHA-256 y la separación StoreAMO/instalador."
      }
    ]
  },
  "evidence": {
    "status": "inspected",
    "refs": [".github/workflows/install-ci.yml", "scripts/autocheck.sh", "amoedo7/StoreAMO:bootstrap"]
  }
}
